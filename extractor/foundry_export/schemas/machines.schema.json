{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "foundry-data/machines@1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "foundry-data/machines@1"
    },
    "gameVersion": {
      "type": "string"
    },
    "steamBuildId": {
      "type": [
        "string",
        "null"
      ]
    },
    "count": {
      "type": "integer"
    },
    "machines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "item": {
            "type": [
              "string",
              "null"
            ]
          },
          "modeName": {
            "type": [
              "string",
              "null"
            ]
          },
          "itemAlternatives": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "type": {
            "type": [
              "string",
              "null"
            ]
          },
          "size": {
            "$ref": "#/$defs/vec3"
          },
          "power": {
            "type": "object",
            "properties": {
              "subType": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "componentType": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "consumptionKW": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "hasEnergyGridConnection": {
                "type": "boolean"
              },
              "hasPoleGridConnection": {
                "type": "boolean"
              },
              "poleGridType": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "subType",
              "componentType",
              "consumptionKW",
              "hasEnergyGridConnection",
              "hasPoleGridConnection",
              "poleGridType"
            ],
            "additionalProperties": false
          },
          "crafting": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "Producer",
                  "AutoProducer",
                  "ModularEntityProducer",
                  "BaseStation"
                ]
              },
              "speedMultiplier": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "recipeSelection": {
                "enum": [
                  "tags",
                  "fixed",
                  "list"
                ]
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "fixedRecipe": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "derived": {
                "type": "object",
                "properties": {
                  "recipes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "recipes"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "kind",
              "speedMultiplier",
              "recipeSelection",
              "tags",
              "fixedRecipe",
              "derived"
            ],
            "additionalProperties": false
          },
          "fluidBoxes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "isInput": {
                  "type": "boolean"
                },
                "capacityLiters": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "transferRateLitersPerSec": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "pipeType": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "fixedElement": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "isInput",
                "capacityLiters",
                "transferRateLitersPerSec",
                "pipeType",
                "fixedElement"
              ],
              "additionalProperties": false
            }
          },
          "itemSlots": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          },
          "assemblyLine": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "role": {
                "enum": [
                  "start",
                  "rail",
                  "producer",
                  "painter",
                  "endConsumer",
                  "merger",
                  "splitter"
                ]
              },
              "speedSlotsPerTick": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "slotWidths": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              },
              "machineType": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "powerPerActionKJ": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "endConsumerSlotCount": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "derived": {
                "type": "object",
                "properties": {
                  "speedMetersPerSec": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                },
                "required": [
                  "speedMetersPerSec"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "role",
              "speedSlotsPerTick",
              "slotWidths",
              "derived"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "identifier",
          "name",
          "item",
          "modeName",
          "itemAlternatives",
          "type",
          "size",
          "power",
          "crafting",
          "fluidBoxes",
          "itemSlots",
          "assemblyLine"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "gameVersion",
    "steamBuildId",
    "count",
    "machines"
  ],
  "additionalProperties": false,
  "$defs": {
    "itemAmount": {
      "type": "object",
      "properties": {
        "item": {
          "type": "string"
        },
        "amount": {
          "type": "integer"
        }
      },
      "required": [
        "item",
        "amount"
      ],
      "additionalProperties": false
    },
    "fluidAmount": {
      "type": "object",
      "properties": {
        "element": {
          "type": "string"
        },
        "liters": {
          "type": "number"
        }
      },
      "required": [
        "element",
        "liters"
      ],
      "additionalProperties": false
    },
    "vec3": {
      "type": "object",
      "properties": {
        "x": {
          "type": [
            "integer",
            "null"
          ]
        },
        "y": {
          "type": [
            "integer",
            "null"
          ]
        },
        "z": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ],
      "additionalProperties": false
    }
  }
}
